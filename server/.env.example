PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=1200
AI_GESTURE_MIN_CONFIDENCE=0.55
LOCAL_GESTURE_CONFIDENCE=0.85
MAX_AI_REQUESTS_PER_MINUTE=30
RATE_LIMIT_MAX=200
SESSION_TTL=3600
LOG_LEVEL=info
NODE_ENV=development

# Vercel: set GEMINI_API_KEY (+ optional GEMINI_MODEL) in Project → Settings → Environment Variables.
# Socket.IO is not available on Vercel Functions; AI uses POST /api/ai/intent over REST.
