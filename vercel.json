{
  "installCommand": "npm install && npm install --prefix server && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/src/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?route=/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?route=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
